{
  "name": "soat-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Soatli profil — Telegram Business bot (Cloudflare Workers + D1, serverless)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute soat --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute soat --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
